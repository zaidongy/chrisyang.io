---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="/posts — chrisyang.io" class="post-page">
  <nav class="nav">
    <a href="/" class="nav-brand">~/chrisyang</a>
  </nav>

  <section class="section posts-list-section">
    <div class="section-inner">
      <h2 class="section-heading">/posts</h2>
      <div class="posts-list">
        {posts.map((post) => (
          <div class="post-list-item">
            <span class="work-type">// {post.data.tag}</span>
            <h3><a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="post-title-link">{post.data.title}</a></h3>
            <time class="post-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
            <p>{post.data.description}</p>
            <a href={`/posts/${post.id.replace(/\.md$/, '')}`} class="work-link">read post →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <footer class="footer">
    <span>© 2026 Chris Yang. All rights reserved.</span>
    <div class="footer-links">
      <a href="https://www.linkedin.com/in/zaidongy/" target="_blank" rel="noopener">linkedin</a>
      <a href="https://github.com/zaidongy" target="_blank" rel="noopener">github</a>
      <a href="mailto:chris@chrisyang.io">email</a>
    </div>
  </footer>
</Layout>
