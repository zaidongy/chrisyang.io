{"nodes": [{"id": "2026_04_26_scroll_animations_gsap", "label": "GSAP", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selected as animation engine for its ScrollTrigger plugin which handles pinning, scroll locking, snap, and scroll-based triggering"}, {"id": "2026_04_26_scroll_animations_scrolltrigger", "label": "GSAP ScrollTrigger", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles scroll-based triggering, pinning sections in place while entrance animations play"}, {"id": "2026_04_26_scroll_animations_scrolltoplugin", "label": "GSAP ScrollToPlugin", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used for proximity-based snap scrollTo with eased deceleration"}, {"id": "2026_04_26_scroll_animations_portfolio_ready", "label": "portfolio-ready Event", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom event dispatched by terminal.js after intro completes; scroll-animations.js waits for it before initializing, preventing premature animation during intro"}, {"id": "2026_04_26_scroll_animations_scroll_locking", "label": "Scroll Locking", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overflow hidden applied during section entrance animation to prevent user from scrolling past incomplete animations; unlocked on timeline completion"}, {"id": "2026_04_26_scroll_animations_proximity_snap", "label": "Proximity-Based Snap", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debounced scroll listener snaps to nearest section within 35% viewport threshold using eased scrollTo; avoids trapping user by not forcing snap if scrolled past midpoint"}, {"id": "2026_04_26_scroll_animations_reduced_motion", "label": "Reduced Motion Accessibility", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prefers-reduced-motion media query check disables all scroll animations; content visible instantly, no scroll locking, no snap triggered"}, {"id": "2026_04_26_scroll_animations_mobile_detection", "label": "Mobile Viewport Detection", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "matchMedia max-width 767px shortens animation durations and adjusts service card direction from alternating sides to single-direction on mobile"}, {"id": "2026_04_26_scroll_animations_hero_clip_in", "label": "Hero Character Clip-In", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-04-26-scroll-animations.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each character clips in from top to bottom with vertical offset and opacity; green yang letters glow last with text-shadow pulse; plays immediately on page load with scroll lock"}, {"id": "2026_04_26_scroll_anima